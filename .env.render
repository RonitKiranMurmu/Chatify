# Render Environment Variables Template
# SECURITY NOTICE: This file contains example values only!
# DO NOT put real credentials here - set them in Render dashboard

# MongoDB Atlas Connection (Set in Render dashboard)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE

# MongoDB Database Name
MONGO_DB=your_database_name

# Flask Secret Key (Generate in Render dashboard)
SECRET_KEY=GENERATE_RANDOM_SECRET_IN_RENDER_DASHBOARD

# Render Environment Detection
RENDER=true

# Port (Render sets this automatically - do not change)
PORT=10000

# IMPORTANT: Never commit real credentials to git!
# Set actual values in Render Environment Variables section