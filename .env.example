# Environment Variables Template for Decentralized Chat
# 🚨 SECURITY WARNING: This file contains EXAMPLE values only!
# Copy this to .env and replace with your REAL credentials

# MongoDB Configuration (Replace with your Atlas connection)
MONGO_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/YOUR_DATABASE?retryWrites=true&w=majority

# Database Name (Replace with your database name)
MONGO_DB=your_database_name

# Security (Generate your own random secret key)
SECRET_KEY=GENERATE_YOUR_OWN_RANDOM_SECRET_KEY_HERE

# P2P Configuration
PORT=8000

# Environment (set to true on Render)
RENDER=false

# 🔒 IMPORTANT SECURITY NOTES:
# 1. Never use these example values in production
# 2. Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# 3. Create your own MongoDB Atlas cluster
# 4. Set real values in Render dashboard, not in code files
