# Flask Configuration
FLASK_APP=app.py
FLASK_ENV=development
SECRET_KEY=chatify-secret-key-change-this-in-production-2025

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/chatify
# For MongoDB Atlas, use:
# MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/chatify?retryWrites=true&w=majority

# Server Configuration
HOST=0.0.0.0
PORT=5000
DEBUG=True

# File Upload Configuration
MAX_FILE_SIZE=16777216
UPLOAD_FOLDER=uploads
ALLOWED_EXTENSIONS=jpg,jpeg,png,gif,pdf,doc,docx,txt,mp4,mp3,wav,ogg,webm

# Session Configuration
SESSION_TYPE=filesystem
PERMANENT_SESSION_LIFETIME=86400

# Security
BCRYPT_LOG_ROUNDS=12

# CORS (for development)
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000
